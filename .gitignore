# Firebase — never commit credentials or service accounts.
# Platform config files generated by `flutterfire configure` contain
# public client identifiers (not secrets), but we keep them out of git by
# default so each developer/environment points at its own Firebase project.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist
firebase.json.local
**/service-account*.json
**/*-firebase-adminsdk-*.json
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
.env
.env.*

# Node (only used for the optional Firestore rules emulator tests)
firebase/rules-tests/node_modules/
.claude_tmp/
