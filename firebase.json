{
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true
    }
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "lets-spill",
          "appId": "1:663678109296:android:59d66ab207d4ea82e1d6b5",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "lets-spill",
          "appId": "1:663678109296:ios:111900e0563c322ce1d6b5",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "lets-spill",
          "configurations": {
            "android": "1:663678109296:android:59d66ab207d4ea82e1d6b5",
            "ios": "1:663678109296:ios:111900e0563c322ce1d6b5",
            "web": "1:663678109296:web:66075428d0bb8c93e1d6b5"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "hosting",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*"
    ]
  }
}